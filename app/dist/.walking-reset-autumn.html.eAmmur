<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#170f23"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"><meta name="description" content="Your thirty-day lantern garden. An illustrated walking ritual."><title>Walking Reset · The Lantern Garden</title><style>@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Caslon+Display&display=swap');
:root{--bg:#170f23;--panel:#281c3a;--panel2:#342345;--ink:#f9efde;--muted:#b1a2bf;--line:#493654;--gold:#ffc96e;--serif:'Libre Caslon Display',Georgia,serif;--sans:'DM Sans',Arial,sans-serif;font-family:var(--sans);color:var(--ink);background:var(--bg);color-scheme:dark}*{box-sizing:border-box}html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}body{margin:0;min-height:100svh;background:radial-gradient(ellipse 700px 600px at 50% 0,#51303b44,transparent 75%),var(--bg)}button,input,select{font:inherit}button{cursor:pointer;color:inherit;-webkit-tap-highlight-color:transparent}a{color:var(--muted);text-decoration:none}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:2px solid var(--gold);outline-offset:3px}[hidden]{display:none!important}svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.svg-defs{position:absolute;width:0;height:0;overflow:hidden}.lamp-glow{opacity:.12}.app{width:min(100%,540px);margin:0 auto;padding:calc(16px + env(safe-area-inset-top,0px)) 18px calc(22px + env(safe-area-inset-bottom,0px))}.app-header{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:0 1px 16px}.eyebrow{font-size:9px;letter-spacing:1.8px;color:var(--gold);margin:0 0 5px;display:block}h1{font:34px/1 var(--serif);letter-spacing:-.5px;margin:0}h2{font:28px/1.15 var(--serif);margin:0}.header-actions{display:flex;gap:8px}.icon{display:grid;place-items:center;background:#34243c80;border:1px solid var(--line);width:36px;height:36px;border-radius:50%;font-size:20px;color:#cebed0}.icon svg{width:17px;height:17px}.icon[aria-pressed=true]{color:var(--gold);border-color:#a67b45}.world{aspect-ratio:1.5;position:relative;isolation:isolate;border-radius:21px;overflow:hidden;background:#3f3140;box-shadow:0 10px 40px #0004,0 0 0 1px #ffe7b519}.scene-base,.scene-art,.scene-effects,.scene-shade{position:absolute;inset:0;pointer-events:none}.scene-base{background:url('data:image/webp;base64,') center/100% 100% no-repeat}.scene-art{overflow:hidden}.art-patch{position:absolute;inset:0;background:url('data:image/webp;base64,') center/100% 100% no-repeat;opacity:0;transition:opacity 1.2s}.scene-shade{background:linear-gradient(180deg,#1c102322,transparent 45%,#1c102344 78%,#1c1023a6)}.scene-count{position:absolute;top:12px;left:13px;font-size:10px;background:#20102599;padding:6px 10px;border:1px solid #ffe3b526;border-radius:30px;backdrop-filter:blur(5px)}.scene-caption{position:absolute;bottom:14px;left:17px;right:17px;pointer-events:none;font:20px var(--serif);text-shadow:0 1px 8px #160f23}.world-track{margin-top:8px;width:105px;height:2px;background:#fae3b73d}.world-track i{display:block;height:100%;background:var(--gold);transition:width .6s}.golden-key{position:absolute;right:14px;top:13px;width:43px;height:43px;border-radius:50%;border:1px solid #fbd88b;background:#68451b99;color:#ffdd85;box-shadow:0 0 25px #ffcd6f8c;animation:keyBob 3s ease-in-out infinite}.golden-key svg{width:25px;height:25px}.secret-door{position:absolute;right:8%;top:65%;border:1px solid #f9dd99a6;background:#3d211fe6;color:#ffe6aa;padding:8px 12px;border-radius:22px;font-size:10px;box-shadow:0 0 23px #ffc56e55}.scene-lantern{position:absolute;left:var(--x);top:var(--y);width:clamp(10px,3.8vw,20px);height:clamp(14px,5.4vw,28px);transform:translate(-50%,-50%);color:#ffdd96;filter:drop-shadow(0 0 6px #ffc061);animation:lampSway 5s ease-in-out infinite;animation-delay:var(--delay)}.scene-lantern svg{width:100%;height:100%}.scene-lantern .lamp-glow{opacity:.6}.scene-lantern .flame{fill:#ffe5ab}.scene-lantern.new{animation:lampArrive 1.5s ease-out both,lampSway 5s 1.5s ease-in-out infinite}.firefly{position:absolute;left:var(--x);top:var(--y);height:3px;width:3px;border-radius:50%;background:#ffe7b0;box-shadow:0 0 9px 2px #ffc25b77;animation:float 7s ease-in-out var(--delay) infinite}.leaf{position:absolute;left:var(--x);top:7%;height:7px;width:4px;border-radius:1px 75% 1px 75%;background:#df9d40;opacity:0;animation:leafFall 15s linear var(--delay) infinite}.smoke{position:absolute;left:68.8%;top:24%;width:15px;height:26px;border-radius:50%;background:#e7d4b63d;filter:blur(4px);opacity:0;animation:smoke 8s ease-out var(--delay) infinite}.shooting-star{position:absolute;left:46%;top:13%;width:40px;height:1px;transform:rotate(-28deg);background:linear-gradient(90deg,transparent,#fff3ca);box-shadow:0 0 7px #ffddaf;opacity:0;animation:shooting 19s ease-in 3s infinite}.scene-star{position:absolute;left:var(--x);top:var(--y);color:#fff1c7;font-size:11px;text-shadow:0 0 8px #ffe3a3;animation:starTwinkle 5s ease-in-out var(--delay) infinite}.scene-reflection{position:absolute;left:10%;top:35%;width:18%;height:8%;background:repeating-linear-gradient(0deg,transparent 0 3px,#ffe7ba3d 4px 5px);mask-image:radial-gradient(ellipse,#0008,transparent 70%);animation:reflect 6s ease-in-out infinite}.scene-finale{position:absolute;inset:0;border:1px solid #ffe5a461;border-radius:21px;box-shadow:inset 0 0 50px #ffb74d22;animation:finale 5s ease-in-out infinite}#sceneHighlight{position:absolute;left:var(--hx,50%);top:var(--hy,50%);width:70px;height:70px;transform:translate(-50%,-50%);pointer-events:none;border-radius:50%;opacity:0}#sceneHighlight.flash{animation:revealHalo 2.4s ease-out}.today-row{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:18px 2px 11px}.today-row h2{font:26px var(--serif)}.today-row h2 span{font:12px var(--sans);color:var(--muted);margin-left:3px}.today-row p{font-size:11px;color:var(--muted);margin:4px 0 0}.primary{background:linear-gradient(180deg,#ffda91,#edac50);border:1px solid #ffcf72;border-radius:30px;padding:12px 17px;font-size:12px;font-weight:600;color:#3a2313;box-shadow:0 5px 20px #efac4633}.primary:active{filter:brightness(1.1)}.quick-extras{display:flex;flex-wrap:wrap;gap:8px}.extra-button{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);background:#2b1d3a;border-radius:25px;padding:8px 12px;font-size:12px;color:#dbcde1}.extra-button .extra-light{height:10px;width:10px;display:block;border:1.5px solid var(--extra);border-radius:50%;background:transparent;box-shadow:none}.extra-button.on{background:color-mix(in srgb,var(--extra) 13%,var(--panel));border-color:color-mix(in srgb,var(--extra) 55%,var(--line))}.extra-button.on .extra-light{background:var(--extra);box-shadow:0 0 8px var(--extra);animation:extraPop .5s}.empty-extras{font-size:11px;color:var(--muted);margin:5px 0}.target-row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:16px 2px 13px}.text-button{background:none;border:0;padding:4px 0;font-size:11px;color:var(--muted)}.text-button strong{font:19px var(--serif);color:var(--ink);margin-left:7px}.text-button span{margin-left:3px}.target-row>span{font-size:9px;color:#aa98b7}.calendar{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:11px}.day{--fill:0;position:relative;border:1px solid #503a62;aspect-ratio:1;border-radius:50%;background:linear-gradient(to top,#dfa1474d calc(var(--fill)*100%),transparent calc(var(--fill)*100%)),radial-gradient(circle at 35% 25%,#3e294f,#261933);box-shadow:inset 0 1px 2px #b189ad13;display:flex;align-items:center;justify-content:center;font:20px var(--serif);padding:0;min-width:0;transition:box-shadow .4s,border-color .4s,background .4s;isolation:isolate;overflow:visible;color:#eadce6}.day::before{content:'';position:absolute;inset:5px;border:1px solid #fff6d30a;border-radius:50%;pointer-events:none}.day.lit{background:radial-gradient(circle at 40% 34%,#fff3bf 0,#fbd782 23%,#ecb253 54%,#a85d26 94%);color:#563018;border-color:#ffd48a;box-shadow:0 0 18px #ffc56b55,0 0 3px #ffe7a9,inset 0 1px 8px #fff4cc,inset 0 -6px 12px #8b451a66;text-shadow:0 1px #fff5c780}.day.lit::before{border-color:#fff0c45c}.day.current{outline:1px solid #b9a8cf;outline-offset:3px}.day:active{filter:brightness(1.2)}.day .extra-dots{position:absolute;bottom:7px;display:flex;gap:4px;left:4px;right:4px;justify-content:center;min-height:5px}.extra-dots b{width:5px;height:5px;border-radius:50%;background:var(--extra);box-shadow:0 0 3px #0004}.day.lit .extra-dots{filter:drop-shadow(0 0 2px #633726)}.day.recorded:not(.lit){color:#f1d8a5}.day .number{position:relative;top:-1px}.progress-row{display:flex;justify-content:space-between;align-items:center;font-size:10px;color:var(--muted);margin:16px 2px 0}.ending{text-align:center;padding:25px 15px;margin-top:20px;border-radius:18px;background:radial-gradient(ellipse at 50% 0,#78512877,#37213c);border:1px solid #c5995d88}.ending h2{font-size:35px}.ending p{font-size:12px;color:#dcc7b6}.secondary{border:1px solid #886747;background:#5c3f2c55;color:#f1d49b;padding:10px 15px;border-radius:25px;font-size:12px}.studio{margin:24px 2px 0;border-top:1px solid var(--line);padding-top:12px;color:var(--muted);font-size:11px}.studio summary{list-style:none;display:flex;justify-content:space-between;cursor:pointer;color:#ad9cbd;font-size:10px}.studio p,.studio small{font-size:10px;line-height:1.65}.studio label{display:block;font-size:11px;margin:12px 0}.studio input,.studio select{display:block;width:100%;margin-top:5px;border:1px solid var(--line);border-radius:9px;background:#23162f;color:var(--ink);padding:9px;font-size:16px}.preview-row{display:flex;align-items:center;gap:10px}.preview-row label{flex:1}.studio-note{min-height:16px}.demo-device{padding:4px 0 15px}.demo-device small{display:block;margin-top:9px}.round{border:1px solid #65506f;background:#30203e;width:36px;height:36px;border-radius:50%;font-size:23px;flex-shrink:0;touch-action:manipulation}.muted{font-size:11px;color:var(--muted);line-height:1.7}footer{display:flex;justify-content:space-between;gap:10px;font-size:8px;color:#86758f;margin:24px 2px 0}footer a{color:#9e8dab}dialog{color:var(--ink);background:var(--panel);border:1px solid #634866;border-radius:24px;width:min(410px,calc(100vw - 24px));max-height:calc(100svh - 30px);padding:26px;box-shadow:0 20px 100px #0008}dialog::backdrop{background:#100819bb;backdrop-filter:blur(5px)}.close{position:absolute;right:12px;top:12px;z-index:3;border:1px solid #a388a14d;background:#2a1a39d9;color:#f6e8de;border-radius:50%;height:32px;width:32px;font-size:22px;line-height:1;display:grid;place-items:center}.day-dialog{padding:0;position:fixed;inset:auto 0 auto;margin:0 auto;top:max(12px,env(safe-area-inset-top,0px));height:min(740px,calc(100svh - 24px));max-height:none;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:#664a71 transparent;scroll-behavior:auto;overflow-anchor:none}.dialog-mood{position:relative;min-height:108px;height:108px;background:url('data:image/webp;base64,') 50% 35%/cover;border-radius:23px 23px 0 0}.mood-shade{position:absolute;inset:0;background:linear-gradient(0deg,var(--panel),#21112544)}.day-heading{position:absolute;left:22px;bottom:10px;right:42px}.day-heading h2{font-size:28px}.day-body{padding:0 22px 16px}.step-controls{display:flex;align-items:center;justify-content:center;gap:10px;margin-top:7px;height:78px}.step-controls input{font:42px/1.15 var(--serif);font-variant-numeric:tabular-nums;width:168px;background:transparent;color:var(--ink);text-align:center;border:0;border-bottom:1px solid #74577d;padding:0 0 1px;border-radius:0;appearance:none;caret-color:var(--gold)}.step-controls input:focus{outline:0;border-bottom-color:var(--gold)}.step-controls label{display:block;text-align:center;font-size:10px;color:var(--muted);margin-top:3px}.goal-note{text-align:center;font-size:11px;margin:5px 0 0;height:18px;white-space:nowrap;font-variant-numeric:tabular-nums}.ritual-stage{height:187px;display:flex;align-items:center;flex-direction:column;justify-content:flex-start;padding-top:17px;position:relative}.hold-button{--p:0;position:relative;isolation:isolate;background:radial-gradient(circle at 40% 30%,#4f344f,#2c1c3b 75%);border:1px solid #a87e5680;border-radius:50%;width:116px;height:116px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;color:#ffd18a;touch-action:none;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none;box-shadow:inset 0 0 calc(var(--p)*40px) #ffc16e88,0 0 calc(var(--p)*45px) #ffc16e66}.hold-ring{position:absolute;inset:-6px;border-radius:50%;background:conic-gradient(#ffda8a calc(var(--p)*360deg),#60466e 0);z-index:-2}.hold-ring::after{content:'';position:absolute;inset:3px;background:#30203d;border-radius:50%;z-index:-1}.hold-aura{position:absolute;inset:0;z-index:-1;border-radius:50%;background:radial-gradient(circle,#ffda8a7f,transparent 72%);opacity:var(--p)}.hold-button svg{width:43px;height:57px;filter:drop-shadow(0 0 calc(2px + var(--p)*8px) #ffc367)}.hold-button .lamp-glow{opacity:calc(.1 + var(--p)*.7)}.hold-button .flame{opacity:calc(.3 + var(--p)*.7)}.hold-button>span:last-child{font-size:10px;color:#e6c6a4}.hold-button.lit{background:radial-gradient(circle at 40% 30%,#fff0b9,#ebb25b 55%,#a36132);color:#694123;border-color:#ffe6a8;box-shadow:0 0 33px #ffc66c77,inset 0 0 20px #fff5cd88}.hold-button.lit .hold-ring{background:#fed08a}.hold-button.lit .hold-ring::after{background:#f1c377}.hold-button.lit .lamp-glow{opacity:.9}.hold-button.lit .flame{opacity:1;fill:#fff4c7;animation:flameFlick 1.4s infinite alternate}.hold-button.lit>span:last-child{color:#653b21;font-weight:600}#holdHint{height:28px;max-width:100%;padding-top:2px;margin:15px 0 0;font-size:10px;line-height:1.4;text-align:center;color:var(--muted)}.day-reveal{height:112px;display:grid;grid-template-columns:105px 1fr;gap:13px;align-items:center;padding:10px;border:1px solid #5d456880;background:#21152d;border-radius:15px;opacity:.55;transition:opacity .5s}.day-reveal.ready{opacity:1;border-color:#c69a6377}.reveal-picture{height:90px;width:105px;overflow:hidden;border-radius:10px;position:relative;background:url('data:image/webp;base64,') center/cover}.reveal-picture img{width:100%;height:100%;object-fit:cover}.reveal-picture .reveal-lamp{position:absolute;left:35%;top:20%;width:30%;height:50%;color:#ffdf9b;filter:drop-shadow(0 0 7px #ffbb57)}.reveal-picture .reveal-lamp .lamp-glow{opacity:.8}.reveal-copy .eyebrow{font-size:7px;letter-spacing:1.2px}.reveal-copy p{font:20px/1.05 var(--serif);margin:6px 0}.reveal-copy button{font-size:10px;color:#d4b78a}.day-reveal.fresh .reveal-picture{animation:revealPicture 1.2s ease-out}.dialog-extra-heading{display:flex;align-items:center;justify-content:space-between;font:19px var(--serif);margin:17px 0 10px}.dialog-extra-heading small{font:9px var(--sans);color:var(--muted)}.day-actions{display:flex;justify-content:space-between;margin:14px 2px 0}.day-actions .text-button{font-size:10px}#saveSteps.invisible{visibility:hidden}.settings-dialog h2,.discoveries-dialog h2{font-size:34px;margin-bottom:20px}.settings-dialog form>label:not(.check-label){font-size:12px;display:block;margin:16px 0}.settings-dialog input[type=date],.settings-dialog input[type=number]{width:100%;display:block;background:#1d1328;border:1px solid var(--line);color:var(--ink);border-radius:10px;padding:11px;font-size:16px;margin-top:7px}.check-label{display:flex;align-items:center;gap:9px;font-size:12px;margin:12px 0}.check-label input{accent-color:var(--gold);width:16px;height:16px}.mint-dot,.peach-dot{height:6px;width:6px;border-radius:50%;display:block;background:#8fd3c0}.peach-dot{background:#f2b8a0}fieldset{border:1px solid var(--line);padding:9px 13px;margin:20px 0;border-radius:10px}legend{font-size:11px;padding:0 5px}.settings-dialog .primary{width:100%}.room-dialog{padding:0;width:min(560px,calc(100vw - 22px));overflow-y:auto}.room-dialog>img{width:100%;display:block;aspect-ratio:1.5;object-fit:cover}.room-copy{padding:23px}.room-copy h2{font-size:35px;margin-bottom:18px}.room-copy small{display:block;font-size:9px;color:var(--muted);margin-top:14px}.discovery-item{border-top:1px solid var(--line);padding:13px 0;display:flex;gap:12px;align-items:center;font-size:12px}.discovery-item i{font-style:normal;color:var(--gold);font-size:20px}.discovery-item span{display:block;color:var(--muted);font-size:10px;margin-top:4px}#toast{position:fixed;bottom:max(20px,env(safe-area-inset-bottom,0px));left:50%;max-width:88vw;transform:translate(-50%,12px);background:#473142;color:#ffe7b9;border:1px solid #a27a59;padding:11px 18px;border-radius:30px;font-size:11px;opacity:0;pointer-events:none;z-index:20;transition:.25s;text-align:center}#toast.show{opacity:1;transform:translate(-50%,0)}.spark{position:fixed;height:5px;width:5px;border-radius:50%;background:#ffdd96;box-shadow:0 0 5px #ffd36d;pointer-events:none;z-index:100;animation:spark .9s ease-out forwards}
@keyframes spark{to{transform:translate(var(--dx),var(--dy)) scale(0);opacity:0}}@keyframes lampSway{0%,100%{transform:translate(-50%,-50%) rotate(-5deg)}50%{transform:translate(-50%,-55%) rotate(5deg)}}@keyframes lampArrive{0%{opacity:0;filter:drop-shadow(0 0 18px #fff1bd);transform:translate(-50%,70%) scale(.3)}40%{opacity:1;filter:drop-shadow(0 0 17px #fff1bd);transform:translate(-50%,-50%) scale(1.6)}100%{transform:translate(-50%,-50%) scale(1);filter:drop-shadow(0 0 6px #ffc061)}}@keyframes revealHalo{0%{opacity:0;box-shadow:0 0 10px 0 #ffd47a}20%{opacity:1;box-shadow:0 0 60px 12px #ffd47a99}100%{opacity:0;box-shadow:0 0 90px 30px #ffd47a00}}@keyframes float{0%,100%{opacity:.2;transform:translate(0,0)}50%{opacity:.9;transform:translate(7px,-12px)}}@keyframes leafFall{0%{opacity:0;transform:translate(0,0) rotate(0)}12%{opacity:.8}90%{opacity:.5}100%{opacity:0;transform:translate(25px,210px) rotate(380deg)}}@keyframes smoke{0%{opacity:0;transform:translate(0,0) scale(.5)}20%{opacity:.6}100%{opacity:0;transform:translate(-15px,-45px) scale(2.5)}}@keyframes shooting{0%,80%,100%{opacity:0;translate:0 0}82%{opacity:1}90%{opacity:0;translate:-110px 58px}}@keyframes starTwinkle{0%,100%{opacity:.2}50%{opacity:1}}@keyframes reflect{50%{transform:translateX(3px);opacity:.6}}@keyframes finale{50%{box-shadow:inset 0 0 75px #ffb74d44}}@keyframes keyBob{50%{transform:translateY(-3px);box-shadow:0 0 35px #ffcd6f99}}@keyframes extraPop{50%{transform:scale(1.4)}}@keyframes flameFlick{to{opacity:.65}}@keyframes revealPicture{0%{filter:brightness(1.8)}100%{filter:none}}
@media(max-width:380px){.app{padding-left:13px;padding-right:13px}.calendar{gap:9px}.day{font-size:18px}.primary{font-size:11px;padding:11px 13px}h1{font-size:31px}.day-body{padding-left:17px;padding-right:17px}.day-reveal{grid-template-columns:94px 1fr}.reveal-picture{width:94px}.day-heading{left:17px}}@media(min-width:700px){.app{padding-top:26px}.calendar{gap:13px}.day{font-size:24px}.world{aspect-ratio:1.5}body{background:radial-gradient(ellipse at 50% 0,#4e2b3e88,transparent 60%),var(--bg)}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation:none!important;transition:none!important}.smoke{opacity:.3}.leaf{opacity:.5}.shooting-star{opacity:.6}}

/* Refinements from Sofia's illustrated-world review. */
.world{container-type:inline-size}
.scene-star{width:2px;height:2px;border-radius:50%;background:#fff9e7;box-shadow:0 0 2px .4px #fff5dbb3;animation:none;font-size:0;opacity:1}
.scene-lantern{width:clamp(12px,3.5cqw,19px);height:clamp(16px,4.7cqw,26px);animation:none;filter:drop-shadow(0 0 3px #ffbf6570)}
.scene-lantern::before{content:'';position:absolute;bottom:94%;left:50%;height:var(--cord);width:1px;background:linear-gradient(#483222,#9f7852);box-shadow:1px 0 #e7bd7b33;transform:translateX(-50%)}
.scene-lantern svg{position:relative;filter:drop-shadow(1px 1px 1px #241a17a0)}
.golden-key{width:48px;height:48px;border:0;background:transparent;border-radius:8px;box-shadow:none;animation:none;filter:drop-shadow(1px 2px 1px #27120c) drop-shadow(0 0 5px #ffd16b88)}
.golden-key svg{width:36px;height:36px;transform:rotate(-12deg)}
.golden-key:hover{filter:brightness(1.15) drop-shadow(0 0 7px #ffd16baa)}
.smoke{left:68.1%;top:25.3%;width:2.3%;height:5.5%;background:radial-gradient(ellipse,#e8ddd0a8 10%,#d8d2c375 45%,transparent 75%);filter:blur(1.5px);animation:chimneyCurl 9s ease-out var(--delay) infinite;transform-origin:center bottom}
@keyframes chimneyCurl{0%{opacity:.12;transform:translate(0,0) scale(.5)}15%{opacity:.72}65%{opacity:.4;transform:translate(-8px,-25px) scale(1.5)}100%{opacity:0;transform:translate(-17px,-48px) scale(2.3)}}
.path-leaf{position:absolute;left:var(--x);top:var(--y);width:7px;height:4px;border-radius:15% 70% 20% 60%;background:linear-gradient(30deg,#8b4623,#d4973d 60%,#edb75f);box-shadow:0 1px 1px #26170d80;animation:pathBreeze 21s ease-in-out var(--delay) infinite}
@keyframes pathBreeze{0%,60%,100%{transform:translate(0,0) rotate(0)}66%{transform:translate(9px,-3px) rotate(55deg)}73%{transform:translate(18px,2px) rotate(95deg)}84%{transform:translate(16px,3px) rotate(90deg)}}
.fox-ear,.fox-tail{position:absolute;inset:0;background:url('data:image/webp;base64,') center/100% 100% no-repeat}
.fox-ear{clip-path:polygon(25.3% 58.5%,26.8% 54.3%,27.1% 59.5%);transform-origin:26.7% 59%;animation:foxEar 19s ease-in-out infinite}
.fox-tail{mask-image:radial-gradient(ellipse 5% 2.6% at 26.4% 76.2%,#000 40%,transparent 100%);transform-origin:22.7% 75%;animation:foxTail 27s ease-in-out infinite}
@keyframes foxEar{0%,76%,82%,100%{transform:rotate(0)}78%{transform:rotate(-2deg)}80%{transform:rotate(1deg)}}
@keyframes foxTail{0%,65%,90%,100%{transform:rotate(0)}76%{transform:rotate(-.9deg)}83%{transform:rotate(.3deg)}}
.hold-button.partial{background:radial-gradient(circle at 40% 32%,#87613a,#4c3240 72%);border-color:#c39762;box-shadow:0 0 17px #f2ba5938,inset 0 0 16px #eab26530}
.hold-button.partial .hold-ring{background:#a67b4c}.hold-button.partial .hold-ring::after{background:#503441}.hold-button.partial .lamp-glow{opacity:.45}.hold-button.partial .flame{opacity:.7}.hold-button.partial .hold-aura{opacity:.3}
@media(prefers-reduced-motion:reduce){.smoke{opacity:.6;transform:translateY(-9px)}.path-leaf,.fox-ear,.fox-tail{animation:none!important}}

/* Thirty-day progress and the paper-lantern ritual. */
.challenge-goal{margin:20px 0 22px}.challenge-goal .target-row{margin:0 0 9px;align-items:baseline;gap:12px}.challenge-goal #targetBtn{font-size:12px;text-align:left}.challenge-goal #goalDisplay{font-size:22px;display:inline-block;margin-left:4px}.goal-caption{display:flex;justify-content:space-between;gap:12px;font-size:11px;line-height:1.6;color:var(--muted)}.goal-caption strong{font-weight:500;color:#ddcbb8}.goal-caption #remainingDisplay{color:#edc991}.challenge-track{height:3px;background:#5a43504d;border-radius:5px;margin-top:11px;overflow:hidden}.challenge-track i{display:block;height:100%;width:0;background:linear-gradient(90deg,#c88651,#ffda8a);border-radius:inherit;transition:width .4s}
.step-controls>.round{touch-action:none;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
.hold-button svg{width:57px;height:71px;filter:drop-shadow(0 0 calc(1px + var(--p)*11px) #ffb85d88)}.hold-button .paper-halo{opacity:calc(.08 + var(--p)*.7)}.hold-button .paper-light{opacity:calc(.05 + var(--p)*.95)}.hold-button .paper-body{filter:brightness(calc(.84 + var(--p)*.26))}.hold-button.lit .paper-body{filter:brightness(calc(.92 + var(--day-glow)*.22))}.hold-button.lit .paper-halo{opacity:calc(.2 + var(--day-glow)*.75)}.hold-button.lit .paper-light{opacity:calc(.12 + var(--day-glow)*.8)}.hold-button.lit svg{filter:drop-shadow(0 0 calc(2px + var(--day-glow)*7px) #ffac5d99)}
.hold-button.lit.partial{background:radial-gradient(circle at 40% 32%,rgb(237 175 90 / calc(.15 + var(--day-glow)*.32)),#4c3240 78%);border-color:#c39762;color:#ffe3b0;box-shadow:0 0 calc(8px + var(--day-glow)*20px) #f2ba5950,inset 0 0 16px #eab26530}.hold-button.partial>span:last-child{color:#f1d7b4}.hold-button.partial .hold-aura{opacity:calc(.1 + var(--day-glow)*.4)}
.day.lit.partial{background:radial-gradient(circle at 40% 34%,rgb(244 193 115 / calc(.2 + var(--day-glow)*.48)),#6b4741 62%,#463047);border-color:#cb9c69;color:#fff0cd;box-shadow:0 0 calc(4px + var(--day-glow)*14px) #ffc56b40,inset 0 1px 7px #fff4cc30;text-shadow:none}
.reveal-picture .reveal-lamp{width:43%;height:65%;left:29%;top:12%;filter:drop-shadow(0 0 6px #ffb75b)}.reveal-lamp .paper-light,.reveal-lamp .paper-halo{opacity:.8}
@media(max-width:400px){.goal-caption{font-size:10px;gap:8px}.challenge-goal #goalDisplay{font-size:20px}.challenge-goal #dateRange{font-size:9px}}
/* Quiet living details: only the local artwork and light move. */
.garden-light-flicker{position:absolute;inset:0;background:url('data:image/webp;base64,') center/100% 100% no-repeat;pointer-events:none;animation:paintedLight var(--t,3.7s) ease-in-out var(--d,0s) infinite alternate}
@keyframes paintedLight{0%,100%{filter:brightness(1.02) saturate(1.01);opacity:.8}18%{filter:brightness(1.17) saturate(1.08);opacity:1}43%{filter:brightness(.95);opacity:.78}61%{filter:brightness(1.12);opacity:.94}82%{filter:brightness(1.04);opacity:.88}}
.scene-lantern{animation:none;transform:translate(-50%,-50%)}
.scene-lantern svg{animation:lanternFlameGlow 3.7s ease-in-out var(--delay,0s) infinite alternate}
@keyframes lanternFlameGlow{0%,100%{filter:drop-shadow(0 0 2px #f5b85460) brightness(.98)}24%{filter:drop-shadow(0 0 4px #ffca6d90) brightness(1.1)}53%{filter:drop-shadow(0 0 2px #d99d4f44) brightness(.94)}76%{filter:drop-shadow(0 0 3px #ffcd7590) brightness(1.06)}}
.garden-fox-breath{position:absolute;inset:0;background:url('data:image/webp;base64,') center/100% 100% no-repeat;mask-image:radial-gradient(ellipse 10.8% 11.7% at 24.2% 67.5%,#000 55%,transparent 100%);transform-origin:25% 77%;animation:gardenBreath 6.3s ease-in-out infinite}
@keyframes gardenBreath{0%,100%{transform:scale(1,1)}48%{transform:scale(1.009,1.018)}}
.fox-ear{animation:foxEarClear 18s ease-in-out infinite}
@keyframes foxEarClear{0%,74%,85%,100%{transform:rotate(0deg)}76%{transform:rotate(-5deg)}78%{transform:rotate(2.5deg)}81%{transform:rotate(-1deg)}}
.room-scene{position:relative;aspect-ratio:1.5;overflow:hidden;background:#3c271f;isolation:isolate}
.room-scene>img{display:block;width:100%;height:100%;object-fit:fill}
.room-motion{position:absolute;inset:0;pointer-events:none}
.room-fox-breath,.room-fire-motion{position:absolute;inset:0;background:url('data:image/webp;base64,') center/100% 100% no-repeat}
.room-fox-breath{mask-image:radial-gradient(ellipse 16% 14% at 24% 56%,#000 50%,transparent 100%);transform-origin:28% 66%;animation:roomBreath 5.8s ease-in-out infinite}
@keyframes roomBreath{0%,100%{transform:scale(1,1)}48%{transform:scale(1.011,1.022)}}
.room-fire-motion{mask-image:radial-gradient(ellipse 3.6% 7.8% at 53% 48%,#000 35%,transparent 85%);transform-origin:53% 54%;animation:hearthFlame 2.3s ease-in-out infinite alternate}
@keyframes hearthFlame{0%,100%{filter:brightness(1.02);transform:scale(1,1)}21%{filter:brightness(1.26) saturate(1.1);transform:scale(1.007,1.035)}47%{filter:brightness(.91);transform:scale(1,.987)}69%{filter:brightness(1.17);transform:scale(1.008,1.02)}}
.room-hearth-glow{position:absolute;left:45%;top:36%;width:19%;height:29%;background:radial-gradient(ellipse,#ffbe5d38,transparent 70%);mix-blend-mode:screen;animation:hearthWarmth 4.1s ease-in-out infinite alternate}
@keyframes hearthWarmth{0%,100%{opacity:.45}31%{opacity:.8}57%{opacity:.5}81%{opacity:.95}}
.room-candle{position:absolute;left:var(--x);top:var(--y);width:3%;height:6%;transform:translate(-50%,-50%);border-radius:50%;background:radial-gradient(ellipse,#fff2bba6 0,#ffc1645e 18%,transparent 65%);mix-blend-mode:screen;animation:candleGlow var(--t,3s) ease-in-out var(--d,0s) infinite alternate}
@keyframes candleGlow{0%,100%{opacity:.55;scale:.9 1}28%{opacity:.9;scale:1 1.17}53%{opacity:.45;scale:.85 .95}78%{opacity:.8;scale:1.04 1.08}}
.cup-steam{position:absolute;left:65.1%;top:59.9%;width:1.7%;height:5%;border-radius:50%;background:radial-gradient(ellipse,#f1e6d89c 8%,#d2c6b744 40%,transparent 75%);filter:blur(1.3px);opacity:0;transform-origin:center bottom;animation:teaSteam 6s ease-out var(--d,0s) infinite}
@keyframes teaSteam{0%{opacity:0;transform:translate(0,6px) scale(.45)}20%{opacity:.5}60%{opacity:.28;transform:translate(-3px,-10px) scale(1.1,1.4)}100%{opacity:0;transform:translate(3px,-25px) scale(1.5,1.8)}}
.window-rain{position:absolute;inset:0;overflow:hidden;clip-path:polygon(79% 14%,85% 6%,94% 2%,99.8% 7%,99.8% 46%,78% 45%,78% 26%)}
.window-rain i{position:absolute;left:var(--x);top:var(--y);height:9px;width:1.2px;background:linear-gradient(0deg,#f4f0e38c,transparent);border-radius:50%;opacity:0;animation:windowDrop var(--t,8s) linear var(--d,0s) infinite}
@keyframes windowDrop{0%,10%{opacity:0;transform:translate(0,0)}20%{opacity:.55}75%{opacity:.4}100%{opacity:0;transform:translate(-3px,48px)}}
@media(prefers-reduced-motion:reduce){.garden-light-flicker,.scene-lantern svg,.garden-fox-breath,.fox-ear,.room-fox-breath,.room-fire-motion,.room-hearth-glow,.room-candle,.cup-steam,.window-rain i{animation:none!important}.cup-steam{opacity:.2}.window-rain i{opacity:.25}}

.preview-toolbar{padding:16px;margin:12px 0 20px;border:1px solid #b78c4940;border-radius:18px;background:#2b2038}.preview-toolbar[hidden]{display:none}.preview-toolbar p{margin:6px 0 12px;font-size:15px}.preview-actions,.tour-launch{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.preview-toolbar small{display:block;color:#b9a9c4;margin-top:12px;font-size:11px;line-height:1.6}.preview-actions .secondary{padding:10px 14px}.preview-actions .round{width:36px;height:36px}.tour-launch{margin:16px 0}.preview-actions button:disabled{opacity:.3;cursor:default}

.preview-toolbar .tour-description{font-size:12px;line-height:1.6;color:#e2ccaf;margin:6px 0 14px}.preview-guide{margin:20px 0}.preview-guide h3{font:22px var(--serif);margin-bottom:12px}#previewGuide{max-height:340px;overflow:auto;border:1px solid var(--line);border-radius:12px}#previewGuide button{display:block;text-align:left;width:100%;border:0;border-bottom:1px solid var(--line);padding:12px;background:#20172c}#previewGuide strong{display:block;color:var(--ink);font-size:12px;font-weight:500}#previewGuide span{display:block;color:var(--muted);font-size:11px;line-height:1.6;margin-top:5px}#previewGuide button[aria-pressed=true]{background:#453047;box-shadow:inset 3px 0 var(--gold)}

/* Garden review, 23 October: painted discoveries, living movement, quiet light. */
.secret-door{right:4%;top:53%;width:11%;height:23%;padding:0;border:0;background:transparent;box-shadow:none;border-radius:45% 45% 12% 12%}
.secret-door:focus-visible,.secret-door:hover{box-shadow:0 0 14px #ffd39070;outline:1px solid #ffe6ab80}
.green-firefly{width:1.6px;height:1.6px;background:#ddffac;box-shadow:0 0 2px .5px #c7f78caa,0 0 5px 1.5px #9be66d44}
.smoke{animation:chimneyCurl 5s ease-out var(--delay) infinite;width:2%;height:5%}
.shooting-star{animation:shootingPrompt 14s linear 1s infinite}
@keyframes shootingPrompt{0%{opacity:0;translate:0 0}1%{opacity:1}9%{opacity:0;translate:-120px 60px}10%,100%{opacity:0;translate:0 0}}
.creature,.fox-route{position:absolute;left:var(--x);top:var(--y);width:var(--w);transform:translate(-50%,-100%);transform-origin:center bottom;filter:drop-shadow(0 2px 1px #24161855)}
.creature img,.fox-pose img,.bird-flight img{display:block;width:100%;height:auto;pointer-events:none;user-select:none}
.creature img{animation:creatureBreath 6.4s ease-in-out infinite;transform-origin:center bottom}
@keyframes creatureBreath{0%,100%{transform:scale(1,1)}50%{transform:scale(1.008,1.027)}}
.garden-bird img{animation:birdHead 11s ease-in-out infinite}
@keyframes birdHead{0%,35%,55%,100%{transform:rotate(0)}40%,48%{transform:rotate(6deg)}72%,78%{transform:rotate(-3deg)}}
.bird-travelling{animation:birdLand 3.3s ease-out both}
@keyframes birdLand{0%,78%{opacity:0}100%{opacity:1}}
.bird-flight{position:absolute;left:39%;top:20%;width:7%;animation:birdJourney 3s ease-in-out both}
@keyframes birdJourney{0%{transform:translate(0,0) rotate(-12deg);opacity:1}35%{transform:translate(-60px,-15px) rotate(-5deg)}80%{opacity:1}100%{transform:translate(-165px,68px) rotate(8deg);opacity:0}}
.bird-flight img{animation:wingBeat .18s ease-in-out infinite alternate;transform-origin:50% 55%}
@keyframes wingBeat{to{transform:scaleY(.68) rotate(5deg)}}
.garden-owl img{animation:owlLook 15s ease-in-out infinite;transform-origin:50% 74%}
@keyframes owlLook{0%,40%,65%,100%{transform:rotate(0)}46%,57%{transform:rotate(-6deg)}78%,85%{transform:rotate(4deg)}}
.garden-owl::after{content:'';position:absolute;left:24%;top:22%;width:52%;height:7%;background:#6d4934;opacity:0;border-radius:50%;animation:owlBlink 8s infinite}
@keyframes owlBlink{0%,90%,96%,100%{opacity:0}92%,94%{opacity:.8}}
.garden-hedgehog img{animation:hedgehogSniff 5.3s ease-in-out infinite;transform-origin:85% 80%}
@keyframes hedgehogSniff{0%,60%,100%{transform:rotate(0)}66%,76%{transform:rotate(2deg) scaleX(1.02)}71%,82%{transform:rotate(-1deg)}}
.hedgehog-walking{animation:hedgehogWalk 4s ease-out both}
@keyframes hedgehogWalk{0%{translate:-30px 0}20%{translate:-24px -1px}40%{translate:-17px 0}60%{translate:-10px -1px}100%{translate:0 0}}
.glowing-mushrooms{filter:drop-shadow(0 0 3px #f7df9560) drop-shadow(0 0 9px #e9b85244)}
.glowing-mushrooms img{animation:mushroomWarmth 6s ease-in-out infinite}
@keyframes mushroomWarmth{50%{filter:brightness(1.14) drop-shadow(0 0 3px #ffeebc99)}}
.pond-flowers{animation:flowersOpen 3.2s ease-out both;transform-origin:center bottom}
@keyframes flowersOpen{from{opacity:.2;scale:.72 .85}to{opacity:1;scale:1}}
.pond-flowers img{animation:flowerBreeze 9s ease-in-out infinite alternate;transform-origin:center bottom}
@keyframes flowerBreeze{to{transform:rotate(2deg)}}
.pond-ripple{position:absolute;left:20%;top:40%;width:7%;height:1.6%;border:1px solid #f9dfba99;border-radius:50%;opacity:0;animation:pondRippleQuiet 40s linear var(--d,0s) infinite both;box-shadow:0 0 2px #fff1ca44}
@keyframes pondRipple{0%{opacity:0;transform:scale(.15)}20%{opacity:.8}100%{opacity:0;transform:scale(1.8)}}
.garden-rabbit img{animation:rabbitNose 7s ease-in-out infinite;transform-origin:50% 85%}
@keyframes rabbitNose{0%,55%,85%,100%{transform:scale(1)}61%,69%{transform:scale(1.015,1.025) rotate(-1deg)}65%,74%{transform:scale(1,1.01)}}
.fox-route{width:var(--w);filter:drop-shadow(0 2px 2px #24160866)}.fox-pose{position:relative;transform-origin:50% 90%;animation:foxAlive 5.4s ease-in-out infinite}.fox-walk{position:absolute;inset:auto 0 0;opacity:0}.animal-eye{position:absolute;left:78%;top:28%;width:4%;height:1.5%;background:#694329;opacity:0;animation:owlBlink 12s infinite}.fox-sleeping{animation:sleepBreath 6s ease-in-out infinite}.fox-sleeping .animal-eye{display:none}
@keyframes foxAlive{0%,100%{transform:scale(1)}48%{transform:scale(1.007,1.025)}72%{transform:rotate(-.5deg)}75%{transform:rotate(0)}}
@keyframes sleepBreath{50%{transform:scale(1.015,1.035)}}
.fox-arriving{animation:foxArrive 3.5s ease-out both}.fox-going-home{animation:foxHome 6s ease-in-out both}.fox-arriving .fox-walk,.fox-going-home .fox-walk{animation:walkPose 3.5s linear both}.fox-going-home .fox-walk{animation-duration:6s}.fox-arriving .fox-rest,.fox-going-home .fox-rest{animation:restPose 3.5s linear both}.fox-going-home .fox-rest{animation-duration:6s}
@keyframes foxArrive{0%{translate:-28px 0;opacity:0}12%{opacity:1}70%{translate:0 -1px}100%{translate:0 0}}
@keyframes foxHome{0%{left:25%;scale:1 .9}12%{left:25%;scale:1.06 1}30%{left:39%;top:77%}50%{left:55%;top:77%}72%{left:70%;top:77%}100%{left:82%;top:77%;scale:1}}
@keyframes walkPose{0%,80%{opacity:1}100%{opacity:0}}@keyframes restPose{0%,80%{opacity:0}100%{opacity:1}}
.oak-leaf{position:absolute;left:var(--x);top:var(--y);width:12px;height:14px;opacity:0;animation:oakFall var(--t,12s) linear var(--d,0s) 1 both}
@keyframes oakFall{0%{opacity:0;transform:translate(0,0) rotate(-20deg)}5%{opacity:1}35%{transform:translate(12px,55px) rotate(55deg)}65%{opacity:.9;transform:translate(-8px,110px) rotate(160deg)}85%,100%{opacity:0;transform:translate(18px,160px) rotate(245deg)}}
.canopy-opening{position:absolute;inset:0;background:url('data:image/webp;base64,') center/100% 100% no-repeat;mask-image:radial-gradient(ellipse 15% 17% at 48% 19%,#000 50%,transparent 100%);animation:canopyReveal 4s ease-out both}
@keyframes canopyReveal{from{opacity:0}to{opacity:1}}
.garden-celebration{position:absolute;left:24%;right:15%;bottom:12%;text-align:center;font:clamp(15px,4cqw,23px)/1.3 var(--serif);color:#fff0ce;text-shadow:0 1px 8px #170b13,0 0 20px #1a1024;animation:gatherMessage 6s ease-out both;pointer-events:none}
@keyframes gatherMessage{0%,55%{opacity:0;translate:0 5px}100%{opacity:1;translate:0 0}}
.bird-celebrating{animation:gatherBird 3s ease-in-out both}.fox-gathering{animation:gatherFox 4s ease-in-out both}
@keyframes gatherBird{from{translate:-30px -30px}to{translate:0 0}}@keyframes gatherFox{from{translate:20px 0}to{translate:0 0}}
.reveal-world{position:absolute;inset:0;overflow:hidden}.reveal-world .creature,.reveal-world .fox-route{filter:none}.reveal-world .garden-celebration{font-size:9px}.reveal-world .oak-leaf{width:4px;height:5px}
/* Depth in the ritual: cream core, amber middle, red paper edges and a soft outer halo. */
.hold-button.lit{background:radial-gradient(ellipse at 48% 39%,#fff9da 0%,#ffe9a8 13%,#f6c065 33%,#cb7738 61%,#673344 100%);box-shadow:0 0 12px #ffd98a99,0 0 34px #e68c4755,0 0 65px #d9663c22,inset 0 1px 18px #fff5c799}
.hold-button.lit .hold-aura{inset:-22px;opacity:.8;background:radial-gradient(ellipse,#fff5be66 0%,#ffcb7833 35%,#e4713620 55%,transparent 73%)}
.hold-button.lit.partial{background:radial-gradient(ellipse at 48% 39%,rgb(255 245 202 / calc(.18 + var(--day-glow)*.65)) 0%,rgb(255 202 114 / calc(.15 + var(--day-glow)*.5)) 25%,#8c4e3b 58%,#45283d 100%);box-shadow:0 0 calc(9px + var(--day-glow)*22px) #ffbc6c66,inset 0 0 20px #ffdc9e44}
.hold-button.lit .paper-light{opacity:calc(.25 + var(--day-glow)*.75)}.hold-button.lit svg{filter:drop-shadow(0 0 3px #fff1ac) drop-shadow(0 0 10px #ffa83b99)}
/* Room: a stable ember bed and local, asynchronous firelight. */
.room-fire-motion{animation:emberPaint 7s ease-in-out infinite;transform:none;filter:brightness(1.04) saturate(1.12)}
@keyframes emberPaint{0%,100%{filter:brightness(1.03) saturate(1.12)}43%{filter:brightness(1.13) saturate(1.22)}72%{filter:brightness(1.07) saturate(1.15)}}
.room-ember-bed{position:absolute;left:50.3%;top:51.4%;width:5.5%;height:3%;border-radius:50%;background:radial-gradient(ellipse,#ffd080aa 0,#e84a2480 36%,#b71f1733 64%,transparent 78%);mix-blend-mode:screen;filter:blur(1px);animation:embers 8s ease-in-out infinite alternate}
@keyframes embers{to{filter:blur(1.3px) brightness(1.2);opacity:.8}}
.room-flame{position:absolute;left:52%;top:44%;width:1.5%;height:8%;background:radial-gradient(ellipse at 50% 85%,#fff3bfa0,#ffb64166 45%,transparent 72%);border-radius:70% 30% 40% 60%;mix-blend-mode:screen;transform-origin:center bottom;animation:liveFlame 2.7s ease-in-out -.5s infinite alternate;filter:blur(.5px)}
.flame-b{left:51%;top:46%;height:6%;animation-duration:3.3s;animation-delay:-1.8s}.flame-c{left:54%;top:45%;height:7%;animation-duration:2.2s;animation-delay:-.8s}
@keyframes liveFlame{0%{transform:scale(.85,.8) rotate(-3deg);opacity:.5}38%{transform:scale(1.04,1.12) rotate(4deg);opacity:.8}73%{transform:scale(.9,.92) rotate(-2deg);opacity:.6}100%{transform:scale(1,1.08) rotate(2deg);opacity:.75}}
.room-hearth-glow{left:43%;top:39%;width:23%;height:27%;background:radial-gradient(ellipse,#f2a14844,#d75e2522 40%,transparent 72%);animation:hearthWarmth 6.3s ease-in-out infinite alternate}
.room-fox-breath{animation:roomBreath 5.8s ease-in-out infinite;transform-origin:26% 66%}
.room-fox-ear{position:absolute;inset:0;background:url('data:image/webp;base64,') center/100% 100% no-repeat;clip-path:polygon(21.7% 53%,21.9% 47.7%,24.2% 52.7%);transform-origin:23% 53%;animation:roomEar 17s ease-in-out infinite}
@keyframes roomEar{0%,70%,83%,100%{transform:rotate(0)}74%{transform:rotate(-3deg)}78%{transform:rotate(1deg)}}
.room-candle{width:3.8%;height:8%;background:radial-gradient(ellipse,#fff2bba6 0,#ffca7777 13%,#e8803b33 36%,transparent 70%)}
.rain-streaks{position:absolute;inset:-25% 0;opacity:.45;background:repeating-linear-gradient(103deg,transparent 0px,transparent 12px,#ecf3f661 13px,transparent 14px,transparent 27px);mask-image:repeating-linear-gradient(0deg,#000 0 5px,transparent 8px 21px);animation:rainOutside 1.1s linear infinite}
@keyframes rainOutside{to{transform:translate(-7px,22px)}}
.window-rain i{height:14px;width:1.2px;animation-duration:5s}
@media(prefers-reduced-motion:reduce){.creature,.creature img,.fox-route,.fox-pose,.fox-pose img,.garden-owl::after,.animal-eye,.bird-flight,.bird-flight img,.pond-ripple,.oak-leaf,.canopy-opening,.garden-celebration,.room-flame,.room-ember-bed,.room-fox-ear,.rain-streaks{animation:none!important}.garden-celebration,.canopy-opening{opacity:1}.fox-walk,.bird-flight{display:none}.pond-ripple{opacity:.45}.oak-leaf{opacity:.7}.rain-streaks{opacity:.25}}
